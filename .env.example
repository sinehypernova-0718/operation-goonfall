# ---------------------------------------------------------------------------
# Operation Goonfall — environment configuration
#
# Copy this file to `.env` in the repository root and fill in real values:
#
#     cp .env.example .env
#
# There is a single environment file for the whole workspace. `pnpm dev` loads
# it for both apps: the API reads it at boot, and Vite points `envDir` at the
# repository root so the web app sees the same file.
#
# `.env` is git-ignored. `.env.example` must always list every required
# variable with safe placeholder values.
#
# Only variables prefixed with `VITE_` are exposed to browser code. Never give
# DATABASE_URL or BETTER_AUTH_SECRET a `VITE_` prefix.
# ---------------------------------------------------------------------------

# Which environment this process is running as.
# Allowed values: development | production
APP_ENV=development

# Neon PostgreSQL connection string. Use the *pooled* connection string for the
# running app; the direct one also works for migrations.
# Neon dashboard -> Project -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/operation_goonfall?sslmode=require

# Secret Better Auth uses to sign sessions and tokens. Minimum 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-placeholder-with-a-real-random-32-char-secret

# Public base URL of the API, as the browser sees it. Better Auth uses it to
# build callback and cookie URLs.
BETTER_AUTH_URL=http://localhost:3001

# Optional. Base URL the browser uses to reach the API.
# Leave it empty for local development: Vite proxies /health and /api to the
# local API server, so same-origin requests just work.
# On a deployment, set this to the deployed API origin.
VITE_API_URL=